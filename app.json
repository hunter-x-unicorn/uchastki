{
  "expo": {
    "name": "Участки",
    "slug": "uchastki",
    "owner": "andrey8636s-team",
    "extra": { "eas": { "projectId": "ff77991a-0072-4b8f-a524-01ce7bddf204" } },
    "scheme": "uchastki",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.uchastki.offline",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Участки"
      }
    },
    "android": {
      "package": "app.uchastki.offline",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#4A6DA7",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-font",
      "expo-router",
      "./plugins/with-local-android-signing.cjs"
    ],
    "backgroundColor": "#F5F7FB"
  }
}
