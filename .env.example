# Бесплатный проект на expo.dev → Project settings → General → Project ID.
# Текущий проект уже указан в app.json. Для собственного форка скопируйте
# этот файл в .env.local и укажите ID другого проекта.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Имя владельца проекта Expo (username или организация), при необходимости.
EXPO_OWNER=
